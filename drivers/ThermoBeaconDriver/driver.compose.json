{
  "name": {
    "en": "ThermoBeacon Sensor"
  },
  "class": "sensor",
  "capabilities": [
    "measure_temperature",
    "measure_humidity",
    "measure_voltage",
    "measure_signal_strength",
    "measure_battery",
    "alarm_battery",
    "alarm_generic"
  ],
  "capabilitiesOptions": {
    "measure_temperature": {
      "uiComponent": "sensor",
      "title": {
        "en": "Temperature",
        "de": "Temperatur"
      }
    },
    "alarm_generic": {
      "title": {
        "en": "Button",
        "de": "Taste"
      }
    }
  },
  "ui": {
    "components": [
      {
        "id": "sensor",
        "capabilities": [
          "measure_temperature"
        ]
      }
    ]
  },
  "settings": [
    {
      "id": "ble_address",
      "type": "text",
      "label": {
        "en": "BLE Address",
        "de": "BLE-Adresse"
      },
      "value": "",
      "readonly": true
    },
    {
      "id": "ble_uuid",
      "type": "text",
      "label": {
        "en": "BLE UUID",
        "de": "BLE-UUID"
      },
      "value": "",
      "readonly": true
    },
    {
      "id": "model_name",
      "type": "text",
      "label": {
        "en": "Model",
        "de": "Modell"
      },
      "value": "",
      "readonly": true
    },
    {
      "id": "device_type",
      "type": "text",
      "label": {
        "en": "Device Type",
        "de": "Gerätetyp"
      },
      "value": "",
      "readonly": true
    },
    {
      "id": "service_uuid",
      "type": "text",
      "label": {
        "en": "Service UUID",
        "de": "Service-UUID"
      },
      "value": "",
      "readonly": true
    }
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "ble"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "energy": {
    "batteries": [
      "OTHER"
