{
  "id": "de.ftedv.thermopro",
  "version": "1.6.1",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "brandColor": "#4aa3df",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "BLE Sensors",
    "de": "BLE Sensors"
  },
  "description": {
    "en": "Adds support for BLE sensors including climate, plant, and MEATER cooking probes",
    "de": "Unterstützt BLE-Sensoren für Klima, Pflanzen und MEATER-Grillthermometer"
  },
  "tags": {
    "en": [
      "BLE",
      "MEATER",
      "ThermoBeacon",
      "ThermoPro",
      "MiFlora",
      "Flower Care",
      "Govee",
      "H5074",
      "H5075",
      "Plant Sensor",
      "Lanyard",
      "Temperature",
      "Humidity",
      "Soil Moisture",
      "Conductivity",
      "TDS",
      "Lux",
      "TP350",
      "TP351",
      "TP357S",
      "TP357",
      "TP358",
      "TP359",
      "TP393"
    ]
  },
  "category": [
    "climate"
  ],
  "permissions": [
    "homey:wireless:ble"
  ],
  "api": {
    "scanBle": {
      "method": "GET",
      "path": "/scanBle"
    },
    "scanMatchedBle": {
      "method": "GET",
      "path": "/scanBle/matched"
    },
    "scanUnknownBle": {
      "method": "GET",
      "path": "/scanBle/unknown"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Florian Trück",
    "email": "ftrueck@gmail.com"
  },
  "support": "https://community.homey.app/t/app-pro-climate-sensors/156903",
  "homeyCommunityTopicId": 156903,
  "contributing": {
    "donate": {
      "paypal": {
        "username": "ftrueck"
      },
      "patreon": {
        "username": "ftrueck"
      }
    }
  }
}