{
  "name": {
    "en": "MiFlora / Flower Care",
    "de": "MiFlora / Flower Care"
  },
  "class": "sensor",
  "capabilities": [
    "measure_temperature",
    "measure_luminance",
    "measure_moisture",
    "measure_conductivity",
    "measure_signal_strength",
    "measure_battery",
    "alarm_battery"
  ],
  "capabilitiesOptions": {
    "measure_moisture": {
      "uiComponent": "sensor",
      "title": {
        "en": "Soil Moisture",
        "de": "Bodenfeuchte"
      }
    },
    "measure_conductivity": {
      "title": {
        "en": "Soil Conductivity",
        "de": "Bodenleitfähigkeit"
      }
    }
  },
  "ui": {
    "components": [
      {
        "id": "sensor",
        "capabilities": [
          "measure_moisture"
        ]
      }
    ]
  },
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "settings": [
    {
      "id": "initial_gatt_read",
      "type": "checkbox",
      "label": {
        "en": "Read all values once after pairing",
        "de": "Nach dem Hinzufügen einmal alle Werte auslesen"
      },
      "hint": {
        "en": "Creates one short GATT connection after pairing. All later updates remain passive via BLE advertisements.",
        "de": "Stellt nach dem Hinzufügen einmal kurz eine GATT-Verbindung her. Alle späteren Aktualisierungen erfolgen passiv über BLE-Advertisements."
      },
      "value": true
    },
    {
      "id": "daily_gatt_battery_read",
      "type": "checkbox",
      "label": {
        "en": "Read battery daily via GATT",
        "de": "Batterie täglich per GATT auslesen"
      },
      "hint": {
        "en": "Connects to the sensor once every 24 hours to refresh its battery level. This also refreshes the other sensor values.",
        "de": "Verbindet sich alle 24 Stunden mit dem Sensor, um den Batteriestand zu aktualisieren. Dabei werden auch die übrigen Sensorwerte aktualisiert."
      },
      "value": false
    },
    {
      "id": "ble_address",
      "type": "text",
      "label": {
        "en": "BLE Address",
        "de": "BLE-Adresse"
      },
      "value": "",
      "readonly": true
    },
    {
      "id": "ble_uuid",
      "type": "text",
      "label": {
        "en": "BLE UUID",
        "de": "BLE-UUID"
      },
      "value": "",
      "readonly": true
    },
    {
      "id": "model_name",
      "type": "text",
      "label": {
        "en": "Model",
        "de": "Modell"
      },
      "value": "",
      "readonly": true
    },
    {
      "id": "service_uuid",
      "type": "text",
      "label": {
        "en": "Service UUID",
        "de": "Service-UUID"
      },
      "value": "",
      "readonly": true
    },
    {
      "id": "product_id",
      "type": "text",
      "label": {
        "en": "Product ID",
        "de": "Produkt-ID"
      },
      "value": "",
      "readonly": true
    }
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "ble"
  ],
  "energy": {
    "batteries": [
      "OTHER"
    ]
  },
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ]
}
